#!/bin/sh
set -eu

APP_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
CONFIG_ROOT=${XDG_CONFIG_HOME:-"$HOME/.config"}/benefactor
DISK_FILE="$CONFIG_ROOT/disks-path"

select_disks() {
    if ! command -v zenity >/dev/null 2>&1; then
        printf '%s\n' "Benefactor needs Disk.1, Disk.2 and Disk.3. Install zenity or set $DISK_FILE to their folder." >&2
        exit 1
    fi
    chosen=$(zenity --file-selection --directory --title="Choose the Benefactor disk folder") || exit 1
    for number in 1 2 3; do
        if [ ! -r "$chosen/Disk.$number" ]; then
            zenity --error --text="The selected folder must contain readable Disk.1, Disk.2 and Disk.3."
            exit 1
        fi
    done
    mkdir -p "$CONFIG_ROOT"
    printf '%s\n' "$chosen" > "$DISK_FILE"
}

if [ ! -r "$DISK_FILE" ]; then
    select_disks
fi
DISK_ROOT=$(sed -n '1p' "$DISK_FILE")
for number in 1 2 3; do
    if [ ! -r "$DISK_ROOT/Disk.$number" ]; then
        : > "$DISK_FILE"
        select_disks
        DISK_ROOT=$(sed -n '1p' "$DISK_FILE")
        break
    fi
done

exec "$APP_ROOT/usr/bin/benefactor-pc" --disk "$DISK_ROOT/Disk.1" "$DISK_ROOT/Disk.2" "$DISK_ROOT/Disk.3" "$@"
